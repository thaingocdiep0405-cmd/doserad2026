# Slim variant of the submission image.
#
# Grand Challenge downloads the execution image once per job, and the graded
# proton-MR set is 11 jobs, so every gigabyte is paid eleven times. The job logs
# show "Downloading the execution image" taking about two minutes against a
# 4.0 GB archive, which is a third of the ~345 s of platform overhead that sits
# on top of our inference time in the leaderboard runtime.
#
# Two things make this safe to prune. TORCH_COMPILE=0 means triton, nvrtc and
# the CUDA headers are never touched, and `objdump -p
# libtorch_cuda.so` shows which CUDA libraries are actually linked: cublas,
# cudart, cudnn, cufft, cufile, curand, cusparse, cusparseLt, nccl and nvshmem
# are NEEDED entries and must stay even though this model never calls most of
# them. cusolver is absent from that list -- it is reached only through the
# dlopen'd libtorch_cuda_linalg.so, which dose inference never loads.
#
# The NEEDED list is not the whole story: libnvJitLink and libcupti are pulled
# in transitively, so both stay. `ldd` inside the built image is the check that
# matters -- it caught exactly this after a first pass deleted them and left
# `import torch` broken.
# torch/bin and torch/testing stay for the same reason: torch/__init__.py
# resolves torch_shm_manager out of torch/bin at import time, and
# torch.autograd.gradcheck imports torch.testing on the way in.
#
# The final stage flattens the result: deleting files in a layer does not shrink
# the image, so the pruned filesystem is copied into a single fresh layer.
FROM pytorch/pytorch:2.9.1-cuda12.6-cudnn9-runtime AS build

ARG TASK=proton-ct
# "network" runs the trained U-Net, "pencilbeam" the pyRadPlan engine.
ARG DOSE_ENGINE=network

RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r user && useradd -m --no-log-init -r -g user user
WORKDIR /opt/app

COPY doserad_proton_ct/submission/requirements.txt doserad_proton_ct/submission/requirements-pb.txt /opt/app/
RUN python -m pip install --no-cache-dir --no-color --requirement /opt/app/requirements.txt && \
    if [ "$DOSE_ENGINE" = "pencilbeam" ]; then \
        python -m pip install --no-cache-dir --no-color --requirement /opt/app/requirements-pb.txt; \
    fi

COPY doserad_proton_ct/submission/app.py doserad_proton_ct/submission/inference.py doserad_proton_ct/submission/inference_pb.py /opt/app/
COPY doserad_proton_ct/submission/beam_parameters.json /opt/app/beam_parameters.json
COPY doserad_proton_ct/src/doserad_proton /opt/app/doserad_proton
COPY doserad_photon_ct/src/doserad_photon_ct /opt/app/doserad_photon_ct

RUN chown -R user:user /opt/app

# Prune. Every path here is either unreachable with TORCH_COMPILE=0 or absent
# from the NEEDED list of libtorch_cuda.so.
RUN set -eu; \
    SP=/opt/conda/lib/python3.11/site-packages; \
    rm -rf \
      "$SP/triton" "$SP/torchvision" "$SP/torchvision.libs" "$SP/torchaudio" \
      "$SP/cmake" "$SP/nvidia/cusolver" "$SP/nvidia/cuda_nvrtc" \
      "$SP/torch/include" "$SP/torch/test" \
      "$SP/torch/lib/libtorch_cuda_linalg.so" \
      "$SP/nvidia/nvshmem/lib/libnvshmem_device.a" \
      "$SP"/nvidia/*/include \
      /opt/conda/pkgs /opt/conda/share/doc /opt/conda/man /opt/conda/share/man \
      /usr/share/doc /usr/share/man /usr/share/locale /root/.cache; \
    find /opt/conda -name "*.pyc" -delete; \
    find /opt/conda -name "__pycache__" -type d -prune -exec rm -rf {} +; \
    find /opt/conda -name "*.a" -delete

FROM scratch

COPY --from=build / /

ENV PATH=/opt/conda/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Both ARGs must be re-declared here: build arguments do not cross stages, and
# an undeclared one expands to the empty string instead of failing.
ARG TASK=proton-ct
ARG DOSE_ENGINE=network
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/app \
    TASK=$TASK \
    INFERENCE_OVERLAP=0.0 \
    RAY_GATE_THRESHOLD=1e-4 \
    ROI_MODE=bbox \
    TORCH_COMPILE=0 \
    DOSE_ENGINE=$DOSE_ENGINE

WORKDIR /opt/app
USER user

LABEL org.grand-challenge.api-method="invoke"
ENTRYPOINT ["python", "app.py"]
